    "test:e2e": "playwright test"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
