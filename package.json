{
  "name": "galactic-federation-alien-shooter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Galactic Federation: a first-person alien shooter built with Three.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
